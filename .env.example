# ── Base de datos ─────────────────────────────────────
# En Railway: referencia el plugin → ${{Postgres.DATABASE_URL}} (red privada, sin egress)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mibolsillo

# ── Auth.js v5 ────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Administradores de la plataforma (panel /admin): correos de Google separados por coma
ADMIN_EMAILS=

# ── Storage (Cloudflare R2, API compatible con S3) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mibolsillo-receipts
# Opcional: otro servicio compatible con S3 (pruebas locales). En producción déjalo vacío.
R2_ENDPOINT=
# Opcional: dominio público/CDN si el bucket sirve lecturas públicas (no recomendado para facturas)
R2_PUBLIC_BASE_URL=

# ── OCR ───────────────────────────────────────────────
# claude (visión + salida estructurada) | gemini
OCR_PROVIDER=claude   # o gemini
ANTHROPIC_API_KEY=
# Si OCR_PROVIDER=gemini (modelo por defecto: gemini-flash-latest; OCR_MODEL lo cambia)
GEMINI_API_KEY=
# OCR_MODEL: claude-haiku-5-5 (claude) o gemini-flash-latest (gemini)
OCR_MODEL=
OCR_MAX_FILE_MB=8

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
